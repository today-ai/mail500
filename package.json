{
  "name": "dispatch-marketing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "node --env-file-if-exists=dispatch/.env dispatch/server.mjs",
