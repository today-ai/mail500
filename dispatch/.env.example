# Local mode binds only to localhost. Set a strong password before starting.
NODE_ENV=development
HOST=127.0.0.1
PORT=3080
ADMIN_PASSWORD=
APP_URL=http://localhost:3080
DATABASE_PATH=./data/dispatch.sqlite
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
UNSUBSCRIBE_SECRET=
# Keep secrets on the server, never in browser settings or source control.
RESEND_API_KEY=
RESEND_DOMAIN_ID=
RESEND_WEBHOOK_ID=
RESEND_WEBHOOK_SECRET=
# Live sends stay disabled until you explicitly set this to true.
ALLOW_SEND=false
# One recipient per request, below the normal default API rate limit.
SEND_INTERVAL_MS=750
